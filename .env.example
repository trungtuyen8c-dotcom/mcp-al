# ── mcp-al-mcp config ── (copy to .env, do NOT commit)

# Backend API base URL (HTTPS required in prod; http only for internal hosts).
MCP_API_BASE=https://api.example.com/api/v1

# (optional) valid key prefix for early validation, e.g. "sk_" | "pk_". Empty = skip check.
MCP_KEY_PREFIX=

# transport: http (online, default) | stdio (local Claude Desktop).
MCP_TRANSPORT=http
PORT=8787
MCP_HTTP_TIMEOUT_MS=10000

# stdio only: API key (format <prefix>...). http does NOT need it (key comes from header/OAuth).
MCP_API_KEY=

# ── OAuth (optional, http only) — lets the ChatGPT app / Claude web connect ──
# Enable OAuth = set BOTH vars below. Users paste their API key at /mcp-oauth/authorize.
# Header-key auth (Claude Desktop/curl/API) keeps working in parallel.
#   secret: openssl rand -hex 32  (>= 16 chars; changing it invalidates all issued tokens)
MCP_OAUTH_SECRET=
MCP_PUBLIC_URL=https://mcp.example.com
